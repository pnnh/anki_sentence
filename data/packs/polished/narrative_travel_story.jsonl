{"uid": "narrative_travel_story-0d27580b1f", "scene": "narrative_travel_story", "scene_zh": "叙事·旅行故事", "scene_en": "Narrative: Travel Story", "group": "个人叙事", "phase": 3, "micro": "unexpected", "micro_zh": "意外", "zh": "去年在外地错过末班车，最后只好打车回酒店。", "en": "Last year, while traveling, I missed the last bus and had to take a taxi back to the hotel.", "sub": "错过末班车，打车回酒店", "angle": "past simple / past continuous + a connector", "pack": "narrative", "pattern": "narrative_travel_story", "topic": "travel_story", "tags": ["pack::narrative", "pattern::narrative_travel_story", "topic::travel_story"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:26:23+00:00"}
