{"uid": "narrative_daily_routine-e07cbd0b71", "scene": "narrative_daily_routine", "scene_zh": "叙事·日常作息", "scene_en": "Narrative: Daily Routine", "group": "个人叙事", "phase": 3, "micro": "weekday", "micro_zh": "工作日", "zh": "我通常七点起床，先去跑步，然后吃早饭。", "en": "I usually get up at seven, go for a run, and then have breakfast.", "sub": "早上七点起床跑步", "angle": "frequency adverb + sequence words (first, then)", "pack": "narrative", "pattern": "narrative_daily_routine", "topic": "daily_routine", "tags": ["pack::narrative", "pattern::narrative_daily_routine", "topic::daily_routine"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:22:05+00:00"}
