{"uid": "grammar_used_to-a9ee57389c", "scene": "grammar_used_to", "scene_zh": "语法·used to", "scene_en": "Grammar: Used To", "group": "语法句型", "phase": 3, "micro": "childhood", "micro_zh": "童年习惯", "zh": "以前我几乎不会做饭，现在能炒几个菜。", "en": "I used to hardly ever cook, but now I can make a few dishes.", "sub": "以前不怎么会做饭", "angle": "used to + verb", "pack": "grammar", "pattern": "used_to", "topic": null, "tags": ["pack::grammar", "pattern::used_to"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:15:07+00:00", "polish_reverted": false}
