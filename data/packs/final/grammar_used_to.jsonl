{"uid": "grammar_used_to-0f568eb359", "scene": "grammar_used_to", "scene_zh": "语法·used to", "scene_en": "Grammar: Used To", "group": "语法句型", "phase": 3, "micro": "childhood", "micro_zh": "童年习惯", "zh": "我以前每天喝咖啡，现在改喝茶了。", "en": "I used to drink coffee every day, but now I drink tea.", "sub": "以前每天喝咖啡", "angle": "used to + verb", "pack": "grammar", "pattern": "used_to", "topic": null, "tags": ["pack::grammar", "pattern::used_to"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:14:53+00:00", "polish_reverted": false}
{"uid": "grammar_used_to-ccd1794fdc", "scene": "grammar_used_to", "scene_zh": "语法·used to", "scene_en": "Grammar: Used To", "group": "语法句型", "phase": 3, "micro": "childhood", "micro_zh": "童年习惯", "zh": "以前我每天早上都要喝一杯咖啡。", "en": "I used to have a cup of coffee every morning.", "sub": "以前每天喝咖啡", "angle": "used to + verb", "pack": "grammar", "pattern": "used_to", "topic": null, "tags": ["pack::grammar", "pattern::used_to"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:14:53+00:00", "polish_reverted": false}
