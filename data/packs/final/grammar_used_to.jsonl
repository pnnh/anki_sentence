{"uid": "grammar_used_to-0081416ba0", "scene": "grammar_used_to", "scene_zh": "语法·used to", "scene_en": "Grammar: Used To", "group": "语法句型", "phase": 3, "micro": "childhood", "micro_zh": "童年习惯", "zh": "那家小店我以前常去，老板都认识我。", "en": "I used to go to that small shop often, and the owner knew me.", "sub": "过去常去那家小店", "angle": "used to + verb", "pack": "grammar", "pattern": "used_to", "topic": null, "tags": ["pack::grammar", "pattern::used_to"], "model": "qwen2.5:7b", "created_at": "2026-11-18T10:14:53+00:00", "polish_reverted": false}
