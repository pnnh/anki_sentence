{"uid": "grammar_third_conditional-e185a50817", "scene": "grammar_third_conditional", "scene_zh": "语法·第三条件句", "scene_en": "Grammar: Third Conditional", "group": "语法进阶", "phase": 6, "micro": "regret", "micro_zh": "后悔与假设", "zh": "如果昨天早点出门，就不会迟到了。", "en": "If I had left home earlier yesterday, I wouldn't have been late.", "sub": "如果昨天早点出门就不会迟到", "angle": "if + had + past participle, would have + past participle", "pack": "grammar", "pattern": "third_conditional", "topic": null, "tags": ["pack::grammar", "pattern::third_conditional"], "model": "qwen2.5:7b", "created_at": "2026-11-19T09:53:53+00:00", "polish_reverted": false}
