{"uid": "grammar_third_conditional-119ff7b8fa", "scene": "grammar_third_conditional", "scene_zh": "语法·第三条件句", "scene_en": "Grammar: Third Conditional", "group": "语法进阶", "phase": 6, "micro": "regret", "micro_zh": "后悔与假设", "zh": "要是早知道路上这么堵，我们就会坐地铁。", "en": "If we had known the road was so busy, we would have taken the subway.", "sub": "如果知道会堵车就坐地铁", "angle": "if + had + past participle, would have + past participle", "pack": "grammar", "pattern": "third_conditional", "topic": null, "tags": ["pack::grammar", "pattern::third_conditional"], "model": "qwen2.5:7b", "created_at": "2026-11-19T09:54:02+00:00", "polish_reverted": false}
{"uid": "grammar_third_conditional-2c6d7f953d", "scene": "grammar_third_conditional", "scene_zh": "语法·第三条件句", "scene_en": "Grammar: Third Conditional", "group": "语法进阶", "phase": 6, "micro": "regret", "micro_zh": "后悔与假设", "zh": "要是提前一个月订票，我们就能省不少钱。", "en": "If we had booked the tickets a month earlier, we would have saved a lot of money.", "sub": "如果早点订票就买到便宜票", "angle": "if + had + past participle, would have + past participle", "pack": "grammar", "pattern": "third_conditional", "topic": null, "tags": ["pack::grammar", "pattern::third_conditional"], "model": "qwen2.5:7b", "created_at": "2026-11-19T09:54:02+00:00", "polish_reverted": false}
{"uid": "grammar_third_conditional-ebe7e4d6aa", "scene": "grammar_third_conditional", "scene_zh": "语法·第三条件句", "scene_en": "Grammar: Third Conditional", "group": "语法进阶", "phase": 6, "micro": "advice", "micro_zh": "事后建议", "zh": "如果当时听了你的建议，就不会犯这个错了。", "en": "If I had followed your advice, I wouldn't have made this mistake.", "sub": "如果听你的建议就不会犯错", "angle": "if + had + past participle, would have + past participle", "pack": "grammar", "pattern": "third_conditional", "topic": null, "tags": ["pack::grammar", "pattern::third_conditional"], "model": "qwen2.5:7b", "created_at": "2026-11-19T09:54:02+00:00", "polish_reverted": false}
{"uid": "grammar_third_conditional-4c2640a16e", "scene": "grammar_third_conditional", "scene_zh": "语法·第三条件句", "scene_en": "Grammar: Third Conditional", "group": "语法进阶", "phase": 6, "micro": "advice", "micro_zh": "事后建议", "zh": "要是早听你的，我就不会做错决定了。", "en": "If I had listened to you, I wouldn't have made the wrong decision.", "sub": "如果听你的建议就不会犯错", "angle": "if + had + past participle, would have + past participle", "pack": "grammar", "pattern": "third_conditional", "topic": null, "tags": ["pack::grammar", "pattern::third_conditional"], "model": "qwen2.5:7b", "created_at": "2026-11-19T09:54:02+00:00", "polish_reverted": false}
